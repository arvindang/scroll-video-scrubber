{
  "name": "@arvindang/scroll-video-scrubber",
  "version": "0.1.0",
  "description": "A framework-agnostic, scroll-driven HTML video scrubber.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvindang/scroll-video-scrubber.git"
  },
  "bugs": {
    "url": "https://github.com/arvindang/scroll-video-scrubber/issues"
  },
  "homepage": "https://arv.in/scroll-video-scrubber/",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scroll",
    "scrub",
    "video",
    "scrollytelling",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap && npm run copy:styles",
    "build:site": "vite build",
    "copy:styles": "node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "lint": "biome lint src tests docs vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run check && npm run build:lib"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^24.3.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
